{
  "id": "monday-sync",
  "name": "monday.com Sync",
  "version": "1.5.2",
  "description": "Synchronize Timesheet tasks and todos with monday.com",
  "longDescription": "Bidirectional synchronization between Timesheet and monday.com. Timesheet ToDos are mirrored as monday.com items inside the mapped board, and Timesheet time entries are pushed as subitems of the corresponding item (or as a standalone item on the board when no ToDo is linked).",
  "icon": "monday",
  "category": "project-management",
  "tags": [
    "sync",
    "timesheet",
    "monday",
    "project-management",
    "time-tracking"
  ],
  "dataAccess": [
    "projects",
    "tasks",
    "todos",
    "colleagues",
    "settings"
  ],
  "externalAuth": [
    {
      "id": "monday",
      "type": "oauth2",
      "oauth": {
        "authorizeUrl": "https://auth.monday.com/oauth2/authorize",
        "tokenUrl": "https://auth.monday.com/oauth2/token",
        "scopes": [
          "boards:read",
          "boards:write",
          "me:read",
          "workspaces:read",
          "users:read"
        ]
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "syncDirection": {
        "type": "string",
        "title": "Sync Direction",
        "enum": [
          "bidirectional",
          "timesheet-to-monday",
          "monday-to-timesheet"
        ],
        "default": "bidirectional",
        "x-ui-widget": "radio"
      },
      "webhookSecret": {
        "type": "string",
        "title": "Webhook Secret",
        "x-ui-widget": "password",
        "x-ui-help": "Shared secret used to verify inbound monday.com webhooks. Required for inbound sync."
      },
      "itemNameTemplate": {
        "type": "string",
        "title": "Item Name Template",
        "default": "Timesheet entry {startDate} {startTime}\u2013{endTime}",
        "x-ui-help": "Used as the monday.com item/subitem name when a time entry has no description. Placeholders: {description}, {projectTitle}, {startDate}, {endDate}, {startTime}, {endTime}, {startDateTime}, {endDateTime}, {taskId}."
      }
    },
    "required": [
      "syncDirection"
    ]
  },
  "mappingSchema": {
    "system": "monday",
    "mappings": [
      {
        "id": "projects",
        "title": "Project Mapping",
        "description": "Map Timesheet projects to monday.com boards",
        "localEntity": {
          "type": "project",
          "label": "Timesheet Project",
          "display": "{{title}}"
        },
        "externalEntity": {
          "type": "board",
          "label": "monday.com Board",
          "fetchAction": "list-external-projects"
        },
        "required": true,
        "minMappings": 1
      },
      {
        "id": "users",
        "title": "User Mapping",
        "description": "Map Timesheet users to monday.com workspace members. Optional \u2014 when configured, each user's time entries are assigned to their own monday.com account via the item's person column instead of the OAuth owner.",
        "localEntity": {
          "type": "user",
          "label": "Timesheet User",
          "display": "{{displayName}}"
        },
        "externalEntity": {
          "type": "member",
          "label": "monday.com User",
          "fetchAction": "list-external-users"
        },
        "required": false,
        "minMappings": 0
      }
    ]
  },
  "triggers": [
    {
      "id": "timesheet-changed",
      "type": "event",
      "mode": "sync",
      "name": "Timesheet Changes",
      "description": "Sync task and todo create/update/delete events to monday.com",
      "events": [
        "task.create",
        "task.update",
        "task.delete",
        "todo.create",
        "todo.update",
        "todo.delete"
      ],
      "configurable": true,
      "actionId": "handle-sync-batch"
    },
    {
      "id": "integration-webhook",
      "type": "webhook",
      "name": "monday.com Webhook",
      "description": "Receive inbound item changes from monday.com",
      "configurable": false,
      "actionId": "handle-webhook",
      "webhook": {
        "signature": {
          "header": "authorization",
          "algorithm": "jwt",
          "secretConfigKey": "webhookSecret"
        }
      }
    },
    {
      "id": "full-sync",
      "type": "schedule",
      "mode": "sync",
      "name": "Scheduled Full Sync",
      "description": "Run incremental synchronization for all mapped boards",
      "schedule": "0 2 * * *",
      "timezone": "UTC",
      "configurable": true,
      "events": [
        "task.create",
        "task.update",
        "task.delete",
        "todo.create",
        "todo.update",
        "todo.delete"
      ],
      "actionId": "handle-sync-batch"
    },
    {
      "id": "manual-sync",
      "type": "user_action",
      "name": "Manual Sync",
      "description": "Trigger a sync from settings",
      "userAction": {
        "label": "Sync Now",
        "placement": "settings"
      },
      "actionId": "run-full-sync"
    }
  ],
  "actions": [
    {
      "id": "sync-task-to-external",
      "name": "Sync time entry to monday.com",
      "handler": "syncTaskToExternal"
    },
    {
      "id": "sync-todo-to-external",
      "name": "Sync todo to monday.com",
      "handler": "syncTodoToExternal"
    },
    {
      "id": "handle-sync-batch",
      "name": "Handle sync batch",
      "handler": "handleSyncBatch"
    },
    {
      "id": "sync-task-from-external",
      "name": "Sync task from monday.com",
      "handler": "syncTaskFromExternal",
      "internal": true
    },
    {
      "id": "handle-webhook",
      "handler": "handleWebhook",
      "internal": true
    },
    {
      "id": "run-full-sync",
      "name": "Run full sync",
      "handler": "runFullSync"
    },
    {
      "id": "test-connection",
      "name": "Test connection",
      "handler": "testConnection"
    },
    {
      "id": "list-external-projects",
      "handler": "listExternalProjects",
      "internal": true
    },
    {
      "id": "list-external-users",
      "handler": "listExternalUsers",
      "internal": true
    }
  ],
  "pages": [
    {
      "id": "dashboard",
      "title": "Sync Dashboard",
      "icon": "chart-bar",
      "layout": "dashboard",
      "widgets": [
        {
          "id": "last-sync",
          "type": "metric",
          "title": "Last Sync"
        },
        {
          "id": "sync-stats",
          "type": "metric",
          "title": "Sync Statistics"
        },
        {
          "id": "connection-health",
          "type": "metric",
          "title": "Connection Health"
        },
        {
          "id": "manual-sync-btn",
          "type": "action_button",
          "title": "Manual Sync",
          "config": {
            "actionId": "run-full-sync",
            "label": "Run Full Sync",
            "variant": "primary"
          }
        }
      ]
    }
  ]
}
