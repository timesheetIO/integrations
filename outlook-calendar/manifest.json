{
  "id": "outlook-calendar-sync",
  "name": "Outlook Calendar Sync",
  "version": "1.1.0",
  "description": "Synchronize Timesheet tasks with Outlook Calendar",
  "longDescription": "Bidirectional synchronization between Timesheet tasks and Microsoft Outlook calendar events, for Microsoft 365 work or school accounts and personal Outlook.com accounts. Each Timesheet project maps to an Outlook calendar. Time entries appear as events titled with the project name, with the task description in the event body; events created in Outlook become time entries, with the event subject as the description. Changes, cancellations and deletions flow both ways: Microsoft Graph change notifications bring Outlook edits in, and a daily pass catches up anything that was missed. Events that ended more than 12 months ago are not imported. In many work or school organizations, a Microsoft 365 administrator has to approve Timesheet once before members can connect. Microsoft and Outlook are trademarks of the Microsoft group of companies.",
  "icon": "outlook-calendar",
  "category": "calendar",
  "tags": [
    "sync",
    "timesheet",
    "outlook-calendar",
    "outlook",
    "microsoft-365",
    "calendar"
  ],
  "dataAccess": [
    "projects",
    "tasks",
    "settings"
  ],
  "externalAuth": [
    {
      "id": "microsoft",
      "type": "oauth2",
      "oauth": {
        "authorizeUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
        "scopes": [
          "offline_access",
          "Calendars.ReadWrite"
        ],
        "pkce": true,
        "authorizationParams": {
          "prompt": "select_account"
        },
        "refreshParams": {
          "scope": "offline_access Calendars.ReadWrite"
        }
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "syncDirection": {
        "type": "string",
        "title": "Sync Direction",
        "enum": [
          "bidirectional",
          "timesheet-to-outlook",
          "outlook-to-timesheet"
        ],
        "default": "bidirectional",
        "x-ui-widget": "radio"
      }
    },
    "required": [
      "syncDirection"
    ]
  },
  "mappingSchema": {
    "system": "outlook-calendar",
    "mappings": [
      {
        "id": "projects",
        "title": "Calendar Mapping",
        "description": "Map Timesheet projects to Outlook calendars",
        "localEntity": {
          "type": "project",
          "label": "Timesheet Project",
          "display": "{{title}}"
        },
        "externalEntity": {
          "type": "calendar",
          "label": "Outlook Calendar",
          "fetchAction": "list-external-projects"
        },
        "required": true,
        "minMappings": 1
      }
    ]
  },
  "triggers": [
    {
      "id": "task-changed",
      "type": "event",
      "mode": "sync",
      "name": "Task Changed",
      "description": "Sync task create/update/delete events to Outlook Calendar",
      "events": [
        "task.create",
        "task.update",
        "task.delete"
      ],
      "configurable": true,
      "actionId": "handle-sync-batch"
    },
    {
      "id": "integration-webhook",
      "type": "webhook",
      "name": "Outlook Calendar Notifications",
      "description": "Receive change notifications from Microsoft Graph",
      "configurable": false,
      "actionId": "handle-webhook",
      "webhook": {}
    },
    {
      "id": "full-sync",
      "type": "schedule",
      "mode": "sync",
      "name": "Scheduled Full Sync",
      "description": "Catch up on task changes for all mapped calendars",
      "schedule": "0 2 * * *",
      "timezone": "UTC",
      "configurable": true,
      "events": [
        "task.create",
        "task.update",
        "task.delete"
      ],
      "actionId": "handle-sync-batch"
    },
    {
      "id": "subscription-renewal",
      "type": "schedule",
      "name": "Subscription Renewal",
      "description": "Keep Outlook change notifications alive and catch up on missed changes",
      "schedule": "0 3 * * *",
      "timezone": "UTC",
      "configurable": false,
      "actionId": "renew-subscriptions"
    },
    {
      "id": "manual-sync",
      "type": "user_action",
      "name": "Manual Sync",
      "description": "Trigger a sync from settings",
      "userAction": {
        "label": "Sync Now",
        "placement": "settings"
      },
      "actionId": "run-full-sync"
    }
  ],
  "actions": [
    {
      "id": "sync-task-to-external",
      "name": "Sync task to Outlook Calendar",
      "handler": "syncTaskToExternal"
    },
    {
      "id": "handle-sync-batch",
      "name": "Handle sync batch",
      "handler": "handleSyncBatch"
    },
    {
      "id": "sync-task-from-external",
      "name": "Sync tasks from Outlook Calendar",
      "handler": "syncTaskFromExternal",
      "internal": true
    },
    {
      "id": "handle-webhook",
      "handler": "handleWebhook",
      "internal": true
    },
    {
      "id": "run-full-sync",
      "name": "Run full sync",
      "handler": "runFullSync"
    },
    {
      "id": "renew-subscriptions",
      "name": "Renew subscriptions",
      "handler": "renewSubscriptions",
      "internal": true
    },
    {
      "id": "test-connection",
      "name": "Test connection",
      "handler": "testConnection"
    },
    {
      "id": "list-external-projects",
      "handler": "listExternalProjects",
      "internal": true
    }
  ],
  "pages": [
    {
      "id": "dashboard",
      "title": "Sync Dashboard",
      "icon": "chart-bar",
      "layout": "dashboard",
      "widgets": [
        {
          "id": "last-sync",
          "type": "metric",
          "title": "Last Sync"
        },
        {
          "id": "sync-stats",
          "type": "metric",
          "title": "Sync Statistics"
        },
        {
          "id": "connection-health",
          "type": "metric",
          "title": "Connection Health"
        },
        {
          "id": "manual-sync-btn",
          "type": "action_button",
          "title": "Manual Sync",
          "config": {
            "actionId": "run-full-sync",
            "label": "Run Full Sync",
            "variant": "primary"
          }
        }
      ]
    }
  ]
}
